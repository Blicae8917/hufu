{
  "name": "hufu",
  "version": "0.1.0",
  "description": "Provider-neutral contracts for durable AI-agent task coordination",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@10.14.0",
  "bin": {
    "hufu": "dist/src/hufu/main.js"
  },
  "exports": {
    ".": {
      "types": "./src/hufu/index.ts",
      "default": "./dist/src/hufu/index.js"
    }
  },
  "scripts": {
    "build": "tsc && tsc -p packages/hufu-dsh/tsconfig.json",
    "hufu": "node dist/src/hufu/main.js",
    "test": "tsc -p packages/hufu-dsh/tsconfig.json && tsc && node --test \"dist/tests/**/*.test.js\""
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "hufu-dsh": "workspace:*",
    "typescript": "~5.9.2"
  }
}
