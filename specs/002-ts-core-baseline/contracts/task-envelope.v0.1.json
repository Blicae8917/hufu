{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Blicae8917/hufu/specs/002-ts-core-baseline/contracts/task-envelope.v0.1.json",
  "title": "Hufu TaskEnvelope",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "task_id",
    "project",
    "source",
    "objective",
    "authorization_scope",
    "terminal_conditions"
  ],
  "properties": {
    "schema_version": { "const": "0.1" },
    "task_id": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "source": { "enum": ["native", "external"] },
    "objective": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "authorization_scope": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
    },
    "terminal_conditions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
    },
    "external_ref": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "project": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "repository"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "repository": { "type": "string", "minLength": 1, "pattern": "\\S" }
      }
    }
  }
}
